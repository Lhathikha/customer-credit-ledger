{
  "name": "customer-credit-ledger",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix backend test",
    "seed": "npm --prefix backend run seed"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
